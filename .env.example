POSTGRES_DB=cuescope
POSTGRES_USER=cuescope
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5433
APP_PORT=3001
DATABASE_URL=postgresql://cuescope:replace-with-strong-password@localhost:5433/cuescope
BASE_CURRENCY=ILS
CORS_ORIGIN=*
SEED_USER_NAMES=Demo User
SEED_USER_API_KEYS=replace-with-a-long-local-development-key

# Optional, opt-in: AI-assisted merchant categorization for file imports.
# Leave OPENROUTER_API_KEY unset to keep this feature disabled. Only the
# merchant name and your own category names are ever sent to the model -
# never amounts, dates, or account data. Get a free key at openrouter.ai.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m3:free
